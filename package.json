{
  "name": "n8n-nodes-nexvio",
  "version": "0.1.4",
  "description": "n8n community node for Nexvio AI agents, conversations, contacts, and tickets",
  "keywords": [
    "n8n-community-node-package",
    "nexvio",
    "ai",
    "customer-support"
  ],
  "license": "MIT",
  "homepage": "https://nexvio.ai",
  "author": {
    "name": "Nexvio",
    "email": "support@nexvio.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexvioAI/n8n-nodes-nexvio.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "index.js",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "predev": "n8n-node build",
    "dev": "node scripts/dev.mjs",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "tsx --test tests/**/*.test.ts",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/NexvioApi.credentials.js",
      "dist/credentials/NexvioOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Nexvio/Nexvio.node.js",
      "dist/nodes/NexvioTrigger/NexvioTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.23.0",
    "eslint": "9.29.0",
    "n8n-workflow": "^1.82.0",
    "release-it": "20.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
